{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadie",
  "version": "0.1.0",
  "identifier": "com.outcast1000.roadie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roadie",
        "width": 900,
        "height": 640,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../mcp/roadie-mcp.mjs": "mcp/roadie-mcp.mjs"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["roadie"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNzhENjNDQUU5RDVBRQpSV1N1MWVuS1k0Mm5DakF3akVISGg5WnlJS0VxOFRnczVBTzhiS09MMUxDbktrL0Y4YzhoMDlMbQo=",
      "endpoints": [
        "https://github.com/outcast1000/roadie/releases/latest/download/latest.json"
      ]
    }
  }
}
